{% comment %}
  CloudVaultUS — 21+ Age Gate (Yes / No)
  File: snippets/cvus-age-gate.liquid
  Loaded from: layout/theme.liquid (just before </body>)
{% endcomment %}

<div
  id="cvus-age-gate"
  class="cvus-ag"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cvus-ag-title"
  aria-describedby="cvus-ag-desc"
  aria-hidden="true"
>
  <div class="cvus-ag__backdrop"></div>

  <div class="cvus-ag__modal">
    <div class="cvus-ag__brand">
      <span class="cvus-ag__logo">{{ shop.name }}</span>
      <span class="cvus-ag__tagline">Premium Vape Products</span>
    </div>

    <div class="cvus-ag__seal" aria-hidden="true">
      <span class="cvus-ag__seal-num">21+</span>
    </div>

    <h2 id="cvus-ag-title" class="cvus-ag__heading">Are You 21 or Older?</h2>
    <p id="cvus-ag-desc" class="cvus-ag__description">
      This website sells nicotine vaping products intended for adults
      <strong>21 and older</strong>. By entering, you confirm that you are of
      legal age to purchase nicotine products in your state.
    </p>

    <div class="cvus-ag__actions">
      <button
        type="button"
        id="cvus-ag-yes"
        class="cvus-ag__btn cvus-ag__btn--yes"
        aria-label="Yes, I am 21 or older. Enter the site."
      >
        Yes, I am 21 or older
      </button>

      <button
        type="button"
        id="cvus-ag-no"
        class="cvus-ag__btn cvus-ag__btn--no"
        aria-label="No, I am under 21. Exit the site."
      >
        No, I am under 21
      </button>
    </div>

    <label class="cvus-ag__remember" for="cvus-ag-remember">
      <input type="checkbox" id="cvus-ag-remember" checked>
      <span>Remember me on this device for 30 days</span>
    </label>

    <p class="cvus-ag__legal">
      WARNING: This product contains nicotine. Nicotine is an addictive
      chemical. By entering this site you agree to our
      <a href="/policies/terms-of-service">Terms of Service</a>
      and confirm that nicotine products are legal in your state.
      Sale to anyone under 21 is strictly prohibited.
    </p>
  </div>
</div>
